:: Iterative Fibonacci benchmark in Animal
limit -> 35

prev: int -> 0
curr: int -> 1

result: int -> 0

growl limit == 0 {
    result -> prev
} sniff limit == 1 {
    result -> curr
} wag {
    index: int -> 2
    pounce index <= limit {
        next: int -> prev meow curr
        prev -> curr
        curr -> next
        index -> index meow 1
    }
    result -> curr
}

roar "Fib", limit, "=", result
